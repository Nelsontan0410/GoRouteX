rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function assignedRoutePath(routeId) {
      return /databases/$(database)/documents/dispatchRoutes/$(routeId);
    }

    function isManagedDriver(uid) {
      return exists(profilePath(uid)) && get(profilePath(uid)).data.role == 'driver';
    }

    function isWorkspaceOwner(uid) {
      return isOwner(uid) && !isManagedDriver(uid);
    }

    function isDriverSession(uid) {
      return isOwner(uid) && isManagedDriver(uid)
        && get(profilePath(uid)).data.active != false
        && request.auth.token.role == 'driver'
        && request.auth.token.driverId == uid
        && request.auth.token.tenantId == get(profilePath(uid)).data.tenantId
        && request.auth.token.sessionVersion == get(profilePath(uid)).data.sessionVersion;
    }

    function isAssignedRoute(uid, routeId) {
      return exists(assignedRoutePath(routeId))
        && get(assignedRoutePath(routeId)).data.assignedDriverUid == uid;
    }

    // Allow-list: the only fields a client may write on its own profile. Plan, billing, identity and
    // driver fields are written exclusively by Netlify functions (Admin SDK, which bypasses these rules).
    function signupFields() {
      return ['name', 'email', 'createdAt', 'trialEndsAt', 'planStatus', 'planName', 'planKey',
        'productPlan', 'productPlanKey', 'role', 'tenantId', 'teamMembersCount', 'billingStatus', 'lastLogin'];
    }

    // Mirrors firebase-config.js ensureInitialProfileForNewAccount.
    function validSignup(uid, data) {
      return data.keys().hasOnly(signupFields())
        && data.keys().hasAll(['name', 'email', 'createdAt', 'role', 'tenantId'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() <= 320
        && data.createdAt == request.time
        && (!('trialEndsAt' in data) || (data.trialEndsAt is timestamp
            && data.trialEndsAt <= request.time + duration.value(8, 'd')))
        && (!('lastLogin' in data) || data.lastLogin == request.time)
        && data.role == 'admin'
        && data.tenantId == uid
        && (!('teamMembersCount' in data) || data.teamMembersCount == 1)
        && (!('planStatus' in data) || data.planStatus == 'trial')
        && (!('planName' in data) || data.planName == 'trial')
        && (!('planKey' in data) || data.planKey == 'trial')
        && (!('productPlan' in data) || data.productPlan == 'basic')
        && (!('productPlanKey' in data) || data.productPlanKey == 'basic')
        && (!('billingStatus' in data) || data.billingStatus == 'basic');
    }

    function validOwnerProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])
        && request.resource.data.lastLogin == request.time;
    }

    // Workspace-owner subcollections written by the client (AUDIT_REPORT.md D3 inventory). Collections
    // with their own match blocks below (history, driver*, tracking) are not listed here.
    function ownerCollections() {
      return ['stopsCache', 'stopsChunks', 'routes', 'plannedRoutes', 'operationSnapshots', 'sessions', 'settings',
        'gpsTracking', 'activePlannedRoutes', 'customers', 'orders', 'importProfiles', 'importBatches',
        'orderCustomers', 'orderContacts', 'vehicles'];
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && !uid.matches('^drv_.*') && validSignup(uid, request.resource.data);
      allow update: if isOwner(uid) && resource.data.role != 'driver' && validOwnerProfileUpdate();
      allow update: if isAdmin();
      allow delete: if false;

      match /paymentRequests/{requestId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /billingEvents/{eventId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /cancellationRequests/{requestId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /history/{routeId} {
        allow read: if isWorkspaceOwner(uid) || (isDriverSession(uid) && resource.data.assignedDriverUid == uid);
        allow write: if isWorkspaceOwner(uid);
      }

      match /driverExecutions/{routeId} {
        allow read: if isWorkspaceOwner(uid) || (isDriverSession(uid) && isAssignedRoute(uid, routeId));
        allow write: if isWorkspaceOwner(uid) || (isDriverSession(uid) && isAssignedRoute(uid, routeId));
      }

      match /driverPods/{podId} {
        allow read: if isWorkspaceOwner(uid) || (isDriverSession(uid) && isAssignedRoute(uid, resource.data.routeId));
        allow create: if isWorkspaceOwner(uid) || (isDriverSession(uid) && isAssignedRoute(uid, request.resource.data.routeId));
        allow update, delete: if isWorkspaceOwner(uid);
      }

      match /driverPodPhotos/{photoId} {
        allow read: if isWorkspaceOwner(uid) || (isDriverSession(uid) && isAssignedRoute(uid, resource.data.routeId));
        allow create: if isWorkspaceOwner(uid) || (isDriverSession(uid) && isAssignedRoute(uid, request.resource.data.routeId));
        allow update, delete: if isWorkspaceOwner(uid);
      }

      match /drivers_live/{driverUid} {
        allow read: if isWorkspaceOwner(uid) || (isDriverSession(uid) && driverUid == uid && isAssignedRoute(uid, resource.data.routeId));
        allow write: if isWorkspaceOwner(uid) || (isDriverSession(uid) && driverUid == uid && isAssignedRoute(uid, request.resource.data.routeId));
      }

      match /tracking_sessions/{sessionId} {
        allow read: if isWorkspaceOwner(uid) || (isDriverSession(uid) && isAssignedRoute(uid, resource.data.routeId));
        allow write: if isWorkspaceOwner(uid) || (isDriverSession(uid) && isAssignedRoute(uid, request.resource.data.routeId));
        match /points/{pointId} {
          allow read: if isWorkspaceOwner(uid) || (isDriverSession(uid) && isAssignedRoute(uid, get(/databases/$(database)/documents/users/$(uid)/tracking_sessions/$(sessionId)).data.routeId));
          // The point must belong to its parent session's route; getAfter covers the session written in the same batch.
          allow write: if isWorkspaceOwner(uid) || (isDriverSession(uid)
            && request.resource.data.routeId == getAfter(/databases/$(database)/documents/users/$(uid)/tracking_sessions/$(sessionId)).data.routeId
            && isAssignedRoute(uid, request.resource.data.routeId));
        }
      }

      match /drivers/{driverId} {
        allow read: if isWorkspaceOwner(uid);
        allow write: if false;
      }

      match /driverUsage/{usageId} {
        allow read: if isWorkspaceOwner(uid);
        allow write: if false;
      }

      match /{subcollection}/{document=**} {
        allow read, write: if isWorkspaceOwner(uid) && subcollection in ownerCollections();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
